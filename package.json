{
  "name": "relic-advisor",
  "productName": "Relic Advisor",
  "version": "1.0.0",
  "description": "Warframe relic advisor: reads your relic inventory from screenshots and tells you which items are worth selling on warframe.market, and which relics to open, refine or sell.",
  "author": "XKrust",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/XKrust/projeto-warframe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XKrust/projeto-warframe.git"
  },
  "bugs": {
    "url": "https://github.com/XKrust/projeto-warframe/issues"
  },
  "keywords": [
    "warframe",
    "relics",
    "warframe-market",
    "platinum",
    "ocr",
    "electron"
  ],
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "build:electron": "vite build && node scripts/build-electron.mjs",
    "app": "npm run build:electron && electron .",
    "dist": "npm run build:electron && electron-builder --win nsis",
    "icon": "tsx scripts/make-icon.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:ocr": "node -e \"process.env.OCR=1;require('child_process').execSync('npx vitest run tests/ocr-real.slow.test.ts',{stdio:'inherit',env:process.env})\""
  },
  "build": {
    "appId": "com.xkrust.relicadvisor",
    "productName": "Relic Advisor",
    "copyright": "Copyright © 2026 XKrust — GPL-3.0",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Relic Advisor",
      "license": "LICENSE",
      "artifactName": "Relic-Advisor-Setup-${version}.exe"
    },
    "compression": "maximum",
    "electronLanguages": [
      "pt-BR",
      "en-US",
      "es"
    ]
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
